{
  "name": "@hearth/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Hearth Suite mobile client, iOS & Android via Capacitor, sharing the web UI and Rust core.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --build",
    "test": "node --test tests/mobile.test.mjs",
    "sync": "cap sync",
    "cap": "cap",
    "assets": "pnpm dlx @capacitor/assets@3.0.5 generate --assetPath resources --iconBackgroundColor #D2692E --iconBackgroundColorDark #D2692E --splashBackgroundColor #F4EEE7 --splashBackgroundColorDark #17130F"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/ios": "^6.2.2",
    "@capacitor/local-notifications": "^6.1.3",
    "@hearth/client-shell": "workspace:*",
    "@hearth/core-client": "workspace:*",
    "@hearth/design-system": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "vite": "^6.4.5"
  }
}
