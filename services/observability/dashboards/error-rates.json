{
  "uid": "hearth-error-rates",
  "title": "Hearth Suite, Error rates",
  "tags": ["hearth", "errors"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(hearth_requests_total, service)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Error ratio by endpoint",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "hearth_error_rate{service=~\"$service\"}",
          "legendFormat": "{{service}} {{endpoint}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests/s by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(hearth_requests_total{service=~\"$service\"}[5m])",
          "legendFormat": "{{service}} {{endpoint}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors/s by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(hearth_errors_total{service=~\"$service\"}[5m])",
          "legendFormat": "{{service}} {{endpoint}}"
        }
      ]
    }
  ]
}
