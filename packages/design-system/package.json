{
  "name": "@hearth/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Hearth Suite design system, tokens, components, and brand assets.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./components.css": "./styles/components.css",
