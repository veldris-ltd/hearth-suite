  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:icons": "node scripts/app-icon.mjs",
    "gallery": "vite --open /gallery/",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@fiahfy/icns": "^0.0.7",
    "@resvg/resvg-js": "^2.6.2",
    "png-to-ico": "^3.0.1",
    "vite": "^6.4.5"
  }
}
